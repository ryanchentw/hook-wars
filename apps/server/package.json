{
  "name": "@hookwars/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "PORT=${HOOKWARS_SERVER_PORT:-8787} tsx watch src/main.ts",
    "start": "node dist/server.js",
    "build": "tsc --noEmit && node build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "serve": "PORT=${HOOKWARS_SERVER_PORT:-8787} tsx src/main.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "@hookwars/protocol": "workspace:*",
    "@hookwars/room": "workspace:*",
    "@hookwars/sim": "workspace:*",
    "hono": "^4.13.18",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
